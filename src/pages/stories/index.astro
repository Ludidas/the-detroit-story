---
import BaseLayout from '../../layouts/BaseLayout.astro';
import StoryListing from '../../components/StoryListing.astro';
import { getStoryPage } from '../../lib/content';

// Page 1 of the Stories list. Later pages are built by stories/page/[page].astro.
const { stories, page, totalPages } = await getStoryPage(1);
---

<BaseLayout title="Stories">
  <StoryListing stories={stories} page={page} totalPages={totalPages} />
</BaseLayout>
