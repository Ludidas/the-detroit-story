---
import type { GetStaticPaths } from 'astro';
import type { Story } from '../../lib/types';
import BaseLayout from '../../layouts/BaseLayout.astro';
import StoryMedia from '../../components/StoryMedia.astro';
import StoryBody from '../../components/StoryBody.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import StoryCard from '../../components/StoryCard.astro';
import TellYourStoryBand from '../../components/TellYourStoryBand.astro';
import { getStories, getMoreStories, authorUrl } from '../../lib/content';
import { formatDate } from '../../lib/format';

export const getStaticPaths = (async () => {
  const stories = await getStories();
  return stories.map((story) => ({ params: { slug: story.slug }, props: { story } }));
}) satisfies GetStaticPaths;

interface Props {
  story: Story;
}

const { story } = Astro.props;
const moreStories = await getMoreStories(story.slug, 3);
const tones = ['blue', 'sun', 'gray'] as const;
---

<BaseLayout title={story.title} description={story.excerpt}>
  <article>
    <header class="mx-auto max-w-[784px] px-5 pt-10 sm:px-8 lg:pt-14">
      <a
        href="/stories"
        class="text-[13px] leading-[18px] font-bold tracking-[0.12em] text-brand uppercase hover:underline"
      >
        Stories
      </a>
      <h1
        class="mt-3 font-display text-[clamp(2rem,4.6vw,3.5rem)] leading-[1.05] font-extrabold tracking-[-0.02em] text-balance"
      >
        {story.title}
      </h1>
      <p class="mt-4 text-[clamp(1.125rem,1.6vw,1.375rem)] leading-normal text-muted">{story.excerpt}</p>
      <p class="mt-6 flex flex-wrap items-center gap-x-3 gap-y-1 border-t border-ink pt-4 text-[15px] leading-6">
        {
          story.author && (
            <>
              <span>
                By{' '}
                <a
                  href={authorUrl(story.author)}
                  class="font-bold underline decoration-2 underline-offset-4 hover:text-brand"
                >
                  {story.author.name}
                </a>
              </span>
              <span aria-hidden="true" class="text-muted">
                ·
              </span>
            </>
          )
        }
        <time datetime={story.publishedAt} class="text-muted">{formatDate(story.publishedAt)}</time>
      </p>
    </header>

    <StoryMedia story={story} />

    {
      story.body?.length ? (
        <div class="py-10 lg:py-14">
          <StoryBody blocks={story.body} />
        </div>
      ) : (
        <div class="pb-10" />
      )
    }
  </article>

  {
    moreStories.length > 0 && (
      <section aria-labelledby="more-heading" class="mx-auto max-w-site px-5 pb-12 sm:px-8 lg:pb-16">
        <SectionHeading id="more-heading" title="More stories" link={{ href: '/stories', label: 'All stories' }} />
        <div class="grid gap-x-8 gap-y-10 sm:grid-cols-2 lg:grid-cols-3">
          {moreStories.map((more, i) => (
            <StoryCard story={more} tone={tones[i % tones.length]} />
          ))}
        </div>
      </section>
    )
  }

  <TellYourStoryBand />
</BaseLayout>
