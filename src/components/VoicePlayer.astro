---
/**
  Pop-up player for street interviews. Add it once to any page that shows
  VoiceCards; clicking a card then plays the Instagram video here instead of
  leaving the site. Without JavaScript the cards still link to Instagram.
*/
import { site } from '../lib/site';
---

<dialog
  id="voice-player"
  aria-labelledby="voice-player-title"
  class="m-auto max-h-[94vh] w-[min(92vw,440px)] overflow-hidden rounded-feature bg-white p-0 text-ink backdrop:bg-ink/80"
>
  <div class="flex items-start justify-between gap-4 border-b border-ink/15 p-4">
    <div class="min-w-0">
      <h2 id="voice-player-title" data-title class="font-display text-lg leading-6 font-extrabold"></h2>
      <p data-person class="mt-0.5 text-sm leading-5 text-muted"></p>
    </div>
    <form method="dialog">
      <button
        aria-label="Close"
        class="grid size-11 shrink-0 cursor-pointer place-items-center rounded-full bg-ink text-white transition-colors hover:bg-brand"
      >
        <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="size-5">
          <path d="M6 6l12 12M18 6L6 18" stroke-linecap="round"></path>
        </svg>
      </button>
    </form>
  </div>

  <div class="h-[min(68vh,640px)] bg-ink/5">
    <iframe
      hidden
      data-frame
      title="Interview video on Instagram"
      class="size-full"
      allow="encrypted-media; picture-in-picture; web-share"
      allowfullscreen></iframe>
    <div data-placeholder class="grid size-full place-items-center p-6 text-center font-semibold hatch-cream">
      [The Instagram video plays here once the feed is connected.]
    </div>
  </div>

  <div class="px-4 py-2">
    <a
      data-link
      href={site.instagramUrl}
      target="_blank"
      rel="noopener"
      class="inline-flex min-h-11 items-center gap-1.5 font-bold text-brand hover:underline"
    >
      Open on Instagram <span aria-hidden="true">↗</span>
    </a>
  </div>
</dialog>

<script>
  const dialog = document.querySelector<HTMLDialogElement>('#voice-player');

  if (dialog) {
    const frame = dialog.querySelector<HTMLIFrameElement>('[data-frame]')!;
    const placeholder = dialog.querySelector<HTMLElement>('[data-placeholder]')!;
    const title = dialog.querySelector<HTMLElement>('[data-title]')!;
    const person = dialog.querySelector<HTMLElement>('[data-person]')!;
    const link = dialog.querySelector<HTMLAnchorElement>('[data-link]')!;

    document.addEventListener('click', (event) => {
      if (!(event.target instanceof Element)) return;
      const card = event.target.closest<HTMLAnchorElement>('a[data-voice-player]');
      if (!card) return;
      // Ctrl/Cmd/Shift-clicks still open the post in a new tab as usual.
      if (event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
      event.preventDefault();

      const src = card.dataset.embedSrc;
      title.textContent = card.dataset.voiceTitle ?? '';
      person.textContent = card.dataset.voicePerson ?? '';
      person.hidden = !card.dataset.voicePerson;
      link.href = card.href;
      if (src) {
        frame.src = src;
        frame.hidden = false;
        placeholder.hidden = true;
      } else {
        frame.removeAttribute('src');
        frame.hidden = true;
        placeholder.hidden = false;
      }
      dialog.showModal();
    });

    // Clicking the dark area around the player closes it.
    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) dialog.close();
    });

    // Stop the video when the player closes.
    dialog.addEventListener('close', () => frame.removeAttribute('src'));
  }
</script>
