---
/** The story text: paragraphs, subheadings and pull quotes, in a narrow reading column. */
import type { StoryBlock } from '../lib/types';

interface Props {
  blocks: StoryBlock[];
  /** Replaces the default centered reading column, e.g. when placed inside another layout. */
  class?: string;
}

const { blocks, class: className = 'mx-auto max-w-[784px] px-5 sm:px-8' } = Astro.props;
---

<div class:list={['text-lg leading-8', className]}>
  {
    blocks.map((block) =>
      block.type === 'heading' ? (
        <h2 class="mt-10 font-display text-[26px] leading-8 font-extrabold tracking-[-0.01em] first:mt-0">
          {block.text}
        </h2>
      ) : block.type === 'quote' ? (
        <figure class="my-10 border-y-[3px] border-ink py-6 first:mt-0">
          <blockquote class="font-display text-[clamp(1.5rem,3vw,2rem)] leading-[1.2] font-extrabold tracking-[-0.01em] text-balance">
            <p>“{block.text}”</p>
          </blockquote>
          {block.attribution && (
            <figcaption class="mt-3 text-base font-semibold text-muted">— {block.attribution}</figcaption>
          )}
        </figure>
      ) : (
        <p class="mt-6 first:mt-0">{block.text}</p>
      ),
    )
  }
</div>
