---
import { mainNav, tellYourStory, isCurrent } from '../lib/navigation';

interface Props {
  /** On the home page the site name is the page's main heading. */
  isHome?: boolean;
}

const { isHome = false } = Astro.props;
const NameTag = isHome ? 'h1' : 'p';
const pathname = Astro.url.pathname;
---

<header class="bg-brand text-white">
  <div class="mx-auto max-w-site px-5 pt-6 pb-4 text-center sm:px-8 lg:pt-8">
    <p class="text-xs leading-[18px] font-bold tracking-[0.14em] uppercase">
      A community storytelling project · Detroit, Michigan
    </p>

    <NameTag
      class="mt-3.5 font-display text-[clamp(2.75rem,8vw,6.5rem)] leading-[0.92] font-extrabold tracking-[-0.02em] text-balance uppercase"
    >
      <a href="/" class="focus-visible:outline-sun">The Detroit <span class="text-sun">Story</span></a>
    </NameTag>

    <p class="mt-3.5 text-[clamp(1.125rem,1.7vw,1.375rem)] leading-snug font-bold text-sun">
      Real People. Real Stories. Real Detroit.
    </p>

    <nav
      aria-label="Main"
      class="mt-6 flex flex-wrap items-center justify-center gap-x-7 gap-y-1 border-t-[3px] border-b border-sun py-1.5"
    >
      {
        mainNav.map(({ href, label }) => (
          <a
            href={href}
            aria-current={isCurrent(href, pathname) ? 'page' : undefined}
            class="inline-flex min-h-11 items-center text-[15px] font-semibold text-white decoration-sun decoration-2 underline-offset-[6px] hover:underline focus-visible:outline-sun aria-[current=page]:underline"
          >
            {label}
          </a>
        ))
      }
      <a
        href={tellYourStory.href}
        aria-current={isCurrent(tellYourStory.href, pathname) ? 'page' : undefined}
        class="inline-flex min-h-11 items-center rounded-full bg-sun px-5 text-[15px] font-bold text-ink transition-colors hover:bg-white focus-visible:outline-white"
      >
        {tellYourStory.label}
      </a>
    </nav>
  </div>
</header>
